<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires optimized Release builds. -->
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/UnicodeEmoji.StringProperties/UnicodeEmoji.StringProperties.csproj" />
    <ProjectReference Include="../../src/UnicodeEmoji.StringProperties.Generator/UnicodeEmoji.StringProperties.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../data/unicode/**/*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="data/unicode" />
  </ItemGroup>

</Project>
